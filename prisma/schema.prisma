generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Satu baris saja (id = 1): profil, visi-misi, kontak, jumlah siswa (F-01, F-05, F-06)
model SchoolProfile {
  id           Int      @id @default(1)
  name         String
  tagline      String   @default("")
  about        String   @default("")
  history      String   @default("")
  vision       String   @default("")
  mission      String   @default("") // satu misi per baris
  address      String   @default("")
  phone        String   @default("")
  whatsapp     String   @default("") // format 62812xxxx
  email        String   @default("")
  mapEmbedUrl  String   @default("")
  studentCount Int      @default(0) // diinput manual oleh admin (F-14)
  classCount   Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model Facility {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  imageUrl    String   @default("")
  createdAt   DateTime @default(now())
}

model Teacher {
  id        String   @id @default(cuid())
  name      String
  position  String // jabatan, mis. Kepala Sekolah / Guru
  subject   String   @default("") // mata pelajaran
  photoUrl  String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Satu baris saja (id = 1): informasi PPDB (F-03)
model PpdbInfo {
  id           Int      @id @default(1)
  isOpen       Boolean  @default(false)
  academicYear String   @default("")
  schedule     String   @default("") // satu item per baris
  requirements String   @default("")
  flow         String   @default("")
  fees         String   @default("")
  updatedAt    DateTime @updatedAt
}

enum RegistrationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Data pendaftar PPDB (F-04, F-12)
model Registration {
  id             String             @id @default(cuid())
  regNumber      String             @unique // mis. PPDB-2026-0001
  fullName       String
  gender         String // L / P
  birthPlace     String
  birthDate      DateTime
  nisn           String             @default("")
  previousSchool String
  parentName     String
  parentPhone    String
  address        String
  email          String             @default("")
  parentRelation String             @default("")
  parentJob      String             @default("")
  program        String             @default("")
  infoSource     String             @default("")
  photoId        String? // -> Upload.id (pas foto)
  sklId          String? // -> Upload.id (SKL)
  status        RegistrationStatus @default(PENDING)
  notes          String             @default("")
  createdAt      DateTime           @default(now())
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  imageUrl    String
  createdAt   DateTime @default(now())
}

// Konten halaman publik yang bisa diedit admin (teks, foto, daftar poin). key: header | home | ppdb | footer
model SiteContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// File yang diunggah (gambar sudah dikompres di browser). isPublic=false untuk berkas pendaftar (hanya admin)
model Upload {
  id        String   @id @default(cuid())
  filename  String
  mime      String
  size      Int
  isPublic  Boolean  @default(true)
  data      Bytes
  createdAt DateTime @default(now())

  @@index([isPublic, createdAt])
}


// Akun yang boleh masuk panel admin (login Google). Email di env ADMIN_EMAILS = admin cadangan.
model Admin {
  id          String    @id @default(cuid())
  email       String    @unique // selalu huruf kecil
  name        String    @default("")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdBy   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

// Berita / agenda sekolah (dikelola di /dashboard/berita, tampil di /berita/<slug>)
model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  subtitle    String     @default("") // ringkasan di bawah judul & di kartu berita
  content     String     @default("") // teks berformat sederhana (paragraf, ## subjudul, **tebal**, gambar)
  coverUrl    String     @default("")
  category    String     @default("")
  status      PostStatus @default(DRAFT)
  author      String     @default("")
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
}

// Jejak aktivitas admin (/dashboard/audit-log). Otomatis dipangkas: maks. 5.000 terbaru (lihat src/lib/audit.ts)
model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  actorName  String   @default("")
  actorRole  String   @default("ADMIN") // ADMIN | SISTEM
  action     String // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, UPLOAD, PUBLISH, OPEN, CLOSE
  summary    String // kalimat yang tampil, mis. "mengubah konten Fasilitas"
  target     String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
